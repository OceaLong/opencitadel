# =============================================================================
# CI/e2e 专用环境文件 — 仅供 GitHub Actions e2e-test job 与本地 e2e 冒烟演练使用。
# 全部为 CI dummy 值,绝不可用于任何真实部署 / 生产环境。
# =============================================================================
# CI/e2e ONLY env file — used exclusively by the e2e-test CI job and local
# e2e smoke rehearsals. Every value below is a throwaway CI dummy value,
# generated with `openssl rand -hex 32` purely to satisfy
# api/core/config.py's production-mode validation (length, "not a literal
# placeholder marker", mutual distinctness) so the compose stack can boot.
# NEVER copy this file's values into a real deployment's .env — see
# .env.example + docs/operations/deployment.md for that.
# =============================================================================

# Keep service-level env_file loading aligned with Compose interpolation.
OPENCITADEL_ENV_FILE=.env.e2e
COMPOSE_PROJECT_NAME=opencitadel-acceptance
ACCEPTANCE_PROJECT_ID=opencitadel-acceptance
ACCEPTANCE_RUN_ID=local
ACCEPTANCE_PROVIDER_TOKEN=acceptance-provider-token

# ---------- Deployment mode: local (bundled MinIO), matching --profile local ----------
COMPOSE_PROFILES=local,demo,patrol,acceptance
STORAGE_PROVIDER=minio

ENV=production
LOG_LEVEL=INFO

# ---------- CI dummy secrets (openssl rand -hex 32 each; must be >=32 chars, ----------
# ---------- must not contain change-me/replace-with/changeme, and the 4     ----------
# ---------- *_SECRET/*_KEY fields below must be mutually distinct.          ----------
API_KEY_SECRET=5139497d5eb140a8db4de028b9f6efae84627613b49b16c4e37f26717f1e5642
API_KEY_SECRET_ID=primary
API_KEY_PREVIOUS_SECRETS={}
AUDIT_SIGNING_KEY=388d5a19e1200b7a3210d6388f427f16686b9bc2cad78dd4202e7d1becbc43da
AUDIT_SIGNING_KEY_ID=primary
AUDIT_PREVIOUS_SIGNING_KEYS={}
JWT_SECRET=978830bc780e9e2c55c3a3736537610b00778e6206b4a29fa5981a75c1adf471
# Empty {} = no rotation window (declared to keep parity with .env.example).
JWT_PREVIOUS_SECRETS={}
SESSION_SECRET=d1178d926686f5e1e874c59b28388461a2dc9b4760472082156859be21d4cce1
# Deliberately distinct from SESSION_SECRET so every acceptance run exercises
# the split-trust-domain path on a fresh database: the migration stamps this
# value into execution_authorization_secrets and the runtime signs with it.
DATABASE_AUTHORIZATION_SIGNING_SECRET=9c40f1f0b65e4bfa8f2f6d1f6f5f1e2a7b3c4d5e6f708192a3b4c5d6e7f80915
# Internal Docker sandbox lifecycle broker token (>=32 chars, not placeholder-looking).
SANDBOX_BROKER_TOKEN=85845f498bcc2ea29a8f33d431a5c2490e802cd4280c4641abf652f335b54b62
SANDBOX_TOKEN_SEED=e2e-sandbox-token-seed-0123456789abcdef0123
SANDBOX_DRIVER=auto
SANDBOX_ADDRESS=
SANDBOX_IMAGE=opencitadel-sandbox
SANDBOX_NAME_PREFIX=opencitadel-acceptance-local-sandbox
SANDBOX_NETWORK=opencitadel-acceptance_opencitadel-sandbox-network
SANDBOX_LABELS={"com.docker.compose.project":"opencitadel-acceptance","com.opencitadel.acceptance.project":"opencitadel-acceptance","com.opencitadel.acceptance.run":"local"}
SANDBOX_CHROME_ARGS=--proxy-server=http://opencitadel-sandbox-egress:3128
SANDBOX_HTTPS_PROXY=http://opencitadel-sandbox-egress:3128
SANDBOX_HTTP_PROXY=http://opencitadel-sandbox-egress:3128
SANDBOX_NO_PROXY=localhost,127.0.0.1
SANDBOX_K8S_NAMESPACE=default
SANDBOX_K8S_POD_LABEL=app=opencitadel-sandbox
POLICY_HEAD_REFRESH_INTERVAL_SECONDS=5
POLICY_MAX_STALENESS_SECONDS=30
OPENCITADEL_SHUTDOWN_TIMEOUT_SECONDS=30
# opencitadel-sandbox-broker runs as non-root and needs group access to the
# host's /var/run/docker.sock to manage sandbox containers (docker-compose
# only). Local Docker Desktop defaults to gid 0. CI runners (GitHub Actions
# ubuntu) use a non-zero docker group gid, dynamically resolved via
# $GITHUB_ENV in the e2e-test job (process env takes precedence over --env-file).
DOCKER_SOCK_GID=0
OUTBOUND_ALLOWED_PORTS=80,443,8080,8443,8090,8091,11434
# Acceptance-only Docker DNS names. Production examples stay deny-by-default.
OUTBOUND_PRIVATE_HOST_ALLOWLIST=acceptance-inference,opencitadel-ops-collector
# Production-mode config validation rejects broad RFC1918 ranges (they overlap
# the sandbox network, enabling X-Forwarded-For spoofing). The acceptance stack
# runs everything from the host, so loopback-only trust is sufficient here.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_DOMAIN=
COOKIE_SECURE=true
FRONTEND_BASE_URL=http://localhost:18088
OAUTH_REDIRECT_BASE=http://localhost:18088/api/auth/oauth
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Local-only E2E default. The CI job overwrites this in-place with
# `openssl rand -hex 10` before the stack boots and exports the same
# BOOTSTRAP_ADMIN_PASSWORD value to Playwright.
BOOTSTRAP_ADMIN_PASSWORD=local-e2e-admin-password-strong

# ---------- OAuth (unused in e2e; declared to keep the key set aligned with ----------
# ---------- .env.example — check-docs.sh enforces the parity)               ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Metrics: empty METRICS_TOKEN keeps /api/metrics fail-closed (404) ----------
METRICS_TOKEN=
EXECUTION_KERNEL_METRICS_PORT=9108

# ---------- Ops Patrol probes (compose-default values made explicit) ----------
OPS_COLLECTOR_TARGET_REF=opencitadel-local
OPS_COLLECTOR_ALLOWED_NAMESPACES=["opencitadel"]
OPS_COLLECTOR_TOKEN=e2e-ops-collector-token-0123456789abcdef
OPS_ACTUATOR_TARGET_REF=opencitadel-local
OPS_ACTUATOR_ALLOWED_NAMESPACES=["opencitadel"]
OPS_ACTUATOR_TOKEN=e2e-ops-actuator-token-0123456789abcdef

# ---------- Database (Compose default host: opencitadel-postgres) ----------
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=6850953008d2d9a679cb86933dc185dd367155a176cea271c1f31163db2bd792
POSTGRES_USER=opencitadel_app
# >=16 chars, not "postgres", not placeholder-looking.
POSTGRES_PASSWORD=de947b3b1d06ab022f6be09bdb180d0751a0dd98da4cfe731f4455af7d616151
POSTGRES_MIGRATION_USER=opencitadel_migration_runtime
POSTGRES_MIGRATION_PASSWORD=845f1a77a41d90269aa02c8c7057cb48f75290f11e2ae68f52de8d0dc2b9bb62
POSTGRES_KERNEL_USER=opencitadel_execution_kernel_runtime
POSTGRES_KERNEL_PASSWORD=19e4ec9198872e7ae24b17482b752b3616633b8f0f643046515d143fb1324173
POSTGRES_DB=opencitadel
POSTGRES_HOST=opencitadel-postgres

# ---------- Redis (>=16 chars, not placeholder-looking) ----------
REDIS_HOST=opencitadel-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=fb78aa058de0c8a58c284bf8ab3db9d24987735b3a36eda2b93f86b7938d4c93

# ---------- Tencent COS: unused in local/minio mode, left empty ----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_DOMAIN=

# ---------- MinIO (local mode; bundled by the "local" compose profile) ----------
MINIO_ENDPOINT=opencitadel-minio:9000
# Production-mode config validation rejects the bundled 'minioadmin' default;
# the compose minio service derives MINIO_ROOT_USER/PASSWORD from these same
# values, so client and server stay consistent.
MINIO_ACCESS_KEY=acceptance-minio-access
MINIO_SECRET_KEY=5f2c9a1d7e4b8036c1d2e3f4a5b6c7d8
MINIO_BUCKET=opencitadel
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=

# ---------- Nginx host ports ----------
NGINX_PORT=18088
NGINX_HTTPS_PORT=18443

# Explicit "localhost" (rather than empty) so nginx/generate-config.sh's
# server_name is unambiguous for the e2e run; empty would also work today
# (it defaults to the "_" catch-all) but this documents intent for e2e.
OPENCITADEL_DOMAIN=localhost
HTTPS_ENABLED=false

# ---------- Demo profile (OpsConsole ticket backend for Web Operator e2e) ----------
# docker compose --profile local --profile demo up
OPS_CONSOLE_PORT=19099
