# =============================================================================
# Deployment topology, connectivity, and secrets. Live behavior is managed by
# typed Runtime Policy revisions in PostgreSQL.
# 部署拓扑、连接信息与密钥。运行行为由 PostgreSQL 中的类型化 Runtime Policy 版本管理。
# =============================================================================

# Compose service containers must load the same file selected by `--env-file`.
OPENCITADEL_ENV_FILE=.env.example
COMPOSE_PROJECT_NAME=opencitadel

# ==================== Deployment mode / 部署模式（二选一） ====================
# cloud (default): Tencent COS + inference credentials stored through the control plane
#   -> leave COMPOSE_PROFILES empty + STORAGE_PROVIDER=cos + fill COS_*
# cloud（默认）: 腾讯云 COS + 通过推理控制面存储 Credential
#   -> COMPOSE_PROFILES 留空 + STORAGE_PROVIDER=cos + 填写 COS_*
# local: bundled MinIO + host Ollama
#   -> COMPOSE_PROFILES=local + STORAGE_PROVIDER=minio
#   -> make quickstart sets these automatically for new .env files
# local（全本地）: 内置 MinIO + 宿主机 Ollama
#   -> COMPOSE_PROFILES=local + STORAGE_PROVIDER=minio
COMPOSE_PROFILES=
STORAGE_PROVIDER=cos

# ---------- Required minimum / 必填最小集 ----------

ENV=production
LOG_LEVEL=INFO

# Example placeholders (>=32 chars); override in production: openssl rand -hex 32
# 开箱即用示例（≥32 字符）；生产建议自行覆盖: openssl rand -hex 32
API_KEY_SECRET=REDACTED_API_KEY_SECRET
API_KEY_SECRET_ID=primary
API_KEY_PREVIOUS_SECRETS={}
AUDIT_SIGNING_KEY=replace-with-openssl-rand-hex-32
AUDIT_SIGNING_KEY_ID=primary
AUDIT_PREVIOUS_SIGNING_KEYS={}
JWT_SECRET=change-me-with-openssl-rand-hex-32
# Retired JWT secrets kept alive for verification during a rotation window,
# as a JSON object {"<key-id>": "<old-secret>"}. Newly issued access tokens
# always sign with JWT_SECRET; previous secrets only validate tokens still in
# flight. Leave {} when not rotating. Mirrors API_KEY_PREVIOUS_SECRETS /
# AUDIT_PREVIOUS_SIGNING_KEYS.
JWT_PREVIOUS_SECRETS={}
SESSION_SECRET=change-me-with-openssl-rand-hex-32
# Signing secret for the database authorization context HMAC (the
# `app.auth_signature` GUC the RLS policies validate). Leave EMPTY to reuse
# SESSION_SECRET (the default, backward compatible). Set it to a distinct
# openssl rand -hex 32 value to separate the Starlette session-cookie trust
# domain from the DB authorization one; when set it must be >=32 chars and
# distinct from the other secrets in production.
DATABASE_AUTHORIZATION_SIGNING_SECRET=
# Internal Docker sandbox lifecycle broker token (openssl rand -hex 32)
SANDBOX_BROKER_TOKEN=replace-with-32-byte-random-broker-token
# Deployment-wide seed for deriving each sandbox's data-plane bearer token
# (HMAC(seed, sandbox_id)); shared by api + execution-kernel so any replica
# re-attaching to a sandbox authenticates. Required in production; openssl rand -hex 32.
SANDBOX_TOKEN_SEED=replace-with-32-byte-random-sandbox-token-seed
SANDBOX_DRIVER=auto
SANDBOX_ADDRESS=
SANDBOX_IMAGE=opencitadel-sandbox
SANDBOX_NAME_PREFIX=opencitadel-sandbox
SANDBOX_NETWORK=
SANDBOX_LABELS={}
SANDBOX_CHROME_ARGS=--proxy-server=http://opencitadel-sandbox-egress:3128
SANDBOX_HTTPS_PROXY=http://opencitadel-sandbox-egress:3128
SANDBOX_HTTP_PROXY=http://opencitadel-sandbox-egress:3128
SANDBOX_NO_PROXY=localhost,127.0.0.1
SANDBOX_K8S_NAMESPACE=default
SANDBOX_K8S_POD_LABEL=app=opencitadel-sandbox
POLICY_HEAD_REFRESH_INTERVAL_SECONDS=5
POLICY_MAX_STALENESS_SECONDS=30
OPENCITADEL_SHUTDOWN_TIMEOUT_SECONDS=30
# opencitadel-sandbox-broker runs as non-root and needs group access to the
# host's /var/run/docker.sock to manage sandbox containers (docker-compose
# only). Default 0 matches Docker Desktop (socket owned root:root). On
# native Linux hosts the socket is typically root:docker with a
# host-specific gid — run `stat -c '%g' /var/run/docker.sock` and set that
# value here.
DOCKER_SOCK_GID=0
# Ports allowed for outbound inference and registered MCP servers.
OUTBOUND_ALLOWED_PORTS=80,443,8080,8443,11434
# Exact hostnames only. Leave empty unless an operator-approved private
# endpoint (for example an internal Ollama service) is required.
OUTBOUND_PRIVATE_HOST_ALLOWLIST=
# Only these socket peers may supply X-Forwarded-For. Narrow this to the
# actual reverse-proxy/ingress CIDRs in production.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_DOMAIN=
COOKIE_SECURE=true
FRONTEND_BASE_URL=https://example.com
OAUTH_REDIRECT_BASE=https://example.com/api/auth/oauth
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password

# Database (Compose default host: opencitadel-postgres)
# 数据库（Docker Compose 默认主机名 opencitadel-postgres）
# The container admin role is initialization-only. Migration, API, and the
# execution kernel use distinct non-superuser credentials.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-distinct-admin-password
POSTGRES_MIGRATION_USER=opencitadel_migration_runtime
POSTGRES_MIGRATION_PASSWORD=replace-with-distinct-migration-password
POSTGRES_USER=opencitadel_app
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_KERNEL_USER=opencitadel_execution_kernel_runtime
POSTGRES_KERNEL_PASSWORD=replace-with-distinct-kernel-password
POSTGRES_DB=opencitadel
POSTGRES_HOST=opencitadel-postgres

# Redis authentication is mandatory in production.
# 生产环境必须启用 Redis 认证。
REDIS_HOST=opencitadel-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-strong-redis-password

# Tencent COS (cloud mode; optional in local mode)
# 腾讯云 COS（cloud 模式填写；local 模式可留空）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_DOMAIN=

# MinIO (local mode; optional in cloud mode)
# MinIO（local 模式填写；cloud 模式可留空）
MINIO_ENDPOINT=opencitadel-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=opencitadel
MINIO_SECURE=false
# Optional public URL for LLM image fetch; empty falls back to base64 inline
# 可选：需要 LLM 直接抓取图片 URL 时填写公网/局域网可达地址；留空则自动回退 base64 内联
MINIO_PUBLIC_ENDPOINT=

# Nginx host ports (docker-compose only)
# Nginx 对外端口（仅 docker-compose）
NGINX_PORT=8088
NGINX_HTTPS_PORT=443

# Domain & HTTPS (prepare certs before enabling; default path /etc/letsencrypt/live/${OPENCITADEL_DOMAIN}/)
# 域名与 HTTPS（启用 HTTPS 前需自行准备证书，默认路径 /etc/letsencrypt/live/${OPENCITADEL_DOMAIN}/）
OPENCITADEL_DOMAIN=
HTTPS_ENABLED=false

# Local models (recommended for local mode)
# 本地模型（local 模式推荐）
# Add endpoints, models, and purpose bindings in Settings → Inference.
# 在设置 → 推理中添加 Endpoint、Model 与用途绑定。
# Provider may be Ollama or an OpenAI-compatible service such as vLLM.
# base_url e.g. http://host.docker.internal:11434/v1 for host Ollama from containers

# Google/GitHub SSO (leave empty to disable)
# Google/GitHub SSO（可选；保持空值则不启用对应登录入口）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Prometheus /api/metrics: empty token = endpoint returns 404 (disabled,
# fail-closed); set it to require `Authorization: Bearer <token>` (openssl
# rand -hex 32). Kernel metrics are separate: EXECUTION_KERNEL_METRICS_PORT
# starts a plaintext prometheus_client HTTP server on the kernel container (no
# token — restrict scrape access via network/NetworkPolicy); 0 disables it.
# Prometheus /api/metrics：留空则端点返回 404（默认关闭，fail-closed）；
# 填写后需带 `Authorization: Bearer <token>` 才能访问（openssl rand -hex 32）。
# 执行内核指标独立：EXECUTION_KERNEL_METRICS_PORT 在内核容器内启动明文的
# prometheus_client HTTP server（不做 token 校验，靠网络/NetworkPolicy 限制访问）；
# 设为 0 表示关闭。
METRICS_TOKEN=
EXECUTION_KERNEL_METRICS_PORT=9108

# ---------- Advanced (usually unchanged) / 高级可选项（通常无需修改） ----------

# SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://postgres:postgres@opencitadel-postgres:5432/opencitadel
# SQLALCHEMY_ECHO=false
# POSTGRES_POOL_SIZE=5
# POSTGRES_MAX_OVERFLOW=5
# POSTGRES_POOL_RECYCLE_SECONDS=1800
# Execution-kernel batch / backpressure / poll tuning (advanced). The
# ActivityWorker runs at most EXECUTION_ACTIVITY_MAX_CONCURRENCY claims per
# process (a semaphore); keep it <= POSTGRES_POOL_SIZE + POSTGRES_MAX_OVERFLOW
# so concurrent claims never starve the connection pool. batch_size / idle_poll
# govern the drain loop's page size and idle sleep.
# EXECUTION_ACTIVITY_MAX_CONCURRENCY=8
# EXECUTION_ACTIVITY_BATCH_SIZE=100
# EXECUTION_IDLE_POLL_SECONDS=1.0
# COS_SCHEME=https
# DEMO_INFERENCE_BASE_URL=https://api.openai.com/v1
# DEMO_INFERENCE_CREDENTIAL=sk-...
# DEMO_INFERENCE_MODEL=gpt-4o-mini
# DEMO_INFERENCE_PROVIDER=openai

# Docker 构建期镜像源（覆盖 docker-compose build args 默认值）
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# PIP_TRUSTED_HOST=mirrors.aliyun.com
# UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# UV_VERSION=0.11.33
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
