# Local Compose defaults. Run `make quickstart` to create a private .env and
# generate persistent secrets and the first administrator password automatically.
# 本地默认：运行 make quickstart 自动创建私有 .env、持久密钥和管理员密码。
# Optional overrides: deploy/config/.env.reference. Existing .env is preserved.
OPENCITADEL_ENV_FILE=.env
COMPOSE_PROJECT_NAME=opencitadel
COMPOSE_PROFILES=local
ENV=development
STORAGE_PROVIDER=minio
FRONTEND_BASE_URL=http://localhost:8088

# Private execution originals. Retained sessions, recordings, pins and unresolved
# effects override age. Non-context families keep their existing retention.
EXECUTION_OBJECT_RETENTION_DAYS=30
EXECUTION_OBJECT_ORPHAN_HOURS=24
EXECUTION_OBJECT_GC_BATCH_SIZE=100
