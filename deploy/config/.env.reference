# Advanced deployment reference — not an env file to load wholesale.
# 高级部署配置参考：仅将需要覆盖的选项复制进现有 .env，不要整份加载。
# Defaults live in DeploymentSettings and deployment manifests. Unset entries use
# those defaults; integrations require their own credentials when enabled.
# Quickstart generates independent secrets once in a private .env. Never replace
# stored encryption/signing/database secrets when restarting an existing stack.
# Root .env.example is the local entrypoint; this file lists optional overrides.

# =============================================================================
# Deployment topology, connectivity, and secrets. Live behavior is managed by
# typed Runtime Policy revisions in PostgreSQL.
# 部署拓扑、连接信息与密钥。运行行为由 PostgreSQL 中的类型化 Runtime Policy 版本管理。
# =============================================================================

# Compose service containers must load the same file selected by `--env-file`.
# OPENCITADEL_ENV_FILE=.env
# COMPOSE_PROJECT_NAME=opencitadel

# ==================== Deployment mode / 部署模式（二选一） ====================
# local (default): bundled MinIO; configure inference after first login
#   -> COMPOSE_PROFILES=local + STORAGE_PROVIDER=minio
# local（默认）: 内置 MinIO，首次登录后配置推理 Endpoint/Model/Binding
#   -> COMPOSE_PROFILES=local + STORAGE_PROVIDER=minio
# cloud: Tencent COS + inference credentials stored through the control plane
#   -> leave COMPOSE_PROFILES empty + STORAGE_PROVIDER=cos + fill COS_*
# cloud（云端）: 腾讯云 COS + 通过推理控制面存储 Credential
#   -> COMPOSE_PROFILES 留空 + STORAGE_PROVIDER=cos + 填写 COS_*
# COMPOSE_PROFILES=local
# STORAGE_PROVIDER=minio

# ---------- Default and optional overrides / 默认值与选填覆盖 ----------

# Quickstart defaults to development and generates strong, distinct secrets.
# Production additionally enforces non-placeholder secrets (>=32 characters).
# Secret entries below are intentionally empty references, not runnable values.
# Quickstart 默认 development 并生成独立随机密钥；production 会额外强校验密钥
# （≥32 字符、互不相同、非占位值）。下方空值仅作参考，不是可运行配置。
# ENV=development
# LOG_LEVEL=INFO

# Generated secrets are persisted once in the selected installation file.
# Advanced operators may explicitly supply secrets before first initialization;
# changing existing values requires the corresponding credential/key rotation.
# 密钥首次生成后持久保存；高级部署可在初始化前显式提供。已有安装修改密钥需
# 配套执行凭据或签名密钥轮换，不能以重新生成配置代替轮换。
# API_KEY_SECRET: generated once by quickstart; preserve its stored value.
# API_KEY_SECRET=
# API_KEY_SECRET_ID=primary
# API_KEY_PREVIOUS_SECRETS={}
# 公共事件游标（SSE cursor）HMAC 密钥：留空回退为 sha256(API_KEY_SECRET) 派生值；
# 显式配置后与 API key 加密信任域分离，解码兼容双密钥（轮换窗口内旧游标仍有效）。
# PUBLIC_CURSOR_SECRET: generated once by quickstart; preserve its stored value.
# PUBLIC_CURSOR_SECRET=
# AUDIT_SIGNING_KEY: generated once by quickstart; preserve its stored value.
# AUDIT_SIGNING_KEY=
# AUDIT_SIGNING_KEY_ID=primary
# AUDIT_PREVIOUS_SIGNING_KEYS={}
# JWT_SECRET: generated once by quickstart; preserve its stored value.
# JWT_SECRET=
# Retired JWT secrets kept alive for verification during a rotation window,
# as a JSON object {"<key-id>": "<old-secret>"}. Newly issued access tokens
# always sign with JWT_SECRET; previous secrets only validate tokens still in
# flight. Leave {} when not rotating. Mirrors API_KEY_PREVIOUS_SECRETS /
# AUDIT_PREVIOUS_SIGNING_KEYS.
# JWT_PREVIOUS_SECRETS={}
# SESSION_SECRET: generated once by quickstart; preserve its stored value.
# SESSION_SECRET=
# Signing secret for the database authorization context HMAC (the
# `app.auth_signature` GUC the RLS policies validate). Leave EMPTY to reuse
# SESSION_SECRET (the default, backward compatible). Set it to a distinct
# openssl rand -hex 32 value to separate the Starlette session-cookie trust
# domain from the DB authorization one; when set it must be >=32 chars and
# distinct from the other secrets in production.
# WARNING: the database stamps its copy of this secret during the FIRST
# migration. Setting or changing this value on an existing database requires
# running `python -m app.rotate_db_signing_secret` afterwards, otherwise every
# RLS-protected write fails signature validation.
# DATABASE_AUTHORIZATION_SIGNING_SECRET: generated once by quickstart; preserve its stored value.
# DATABASE_AUTHORIZATION_SIGNING_SECRET=
# Internal Docker sandbox lifecycle broker token (openssl rand -hex 32)
# Compose supplies the internal broker URL; optional external deployments may override it.
# SANDBOX_BROKER_URL=
# SANDBOX_BROKER_TOKEN: generated once by quickstart; preserve its stored value.
# SANDBOX_BROKER_TOKEN=
# Deployment-wide seed for deriving each sandbox's data-plane bearer token
# (HMAC(seed, sandbox_id)); shared by api + execution-kernel so any replica
# re-attaching to a sandbox authenticates. Required in production; openssl rand -hex 32.
# SANDBOX_TOKEN_SEED: generated once by quickstart; preserve its stored value.
# SANDBOX_TOKEN_SEED=
# Compose uses the Docker driver; other deployments may select auto or kubernetes.
# SANDBOX_DRIVER=docker
# SANDBOX_ADDRESS=
# SANDBOX_IMAGE=opencitadel-sandbox
# SANDBOX_NAME_PREFIX=opencitadel-sandbox
# Leave empty to use the compose default (project-prefixed, e.g.
# opencitadel_opencitadel-sandbox-network). Setting the bare network name
# (opencitadel-sandbox-network) makes the broker fail with "network not found".
# SANDBOX_NETWORK=
# SANDBOX_LABELS={}
# SANDBOX_CHROME_ARGS=--proxy-server=http://opencitadel-sandbox-egress:3128
# SANDBOX_HTTPS_PROXY=http://opencitadel-sandbox-egress:3128
# SANDBOX_HTTP_PROXY=http://opencitadel-sandbox-egress:3128
# SANDBOX_NO_PROXY=localhost,127.0.0.1
# SANDBOX_K8S_NAMESPACE=default
# SANDBOX_K8S_POD_LABEL=app=opencitadel-sandbox
# POLICY_HEAD_REFRESH_INTERVAL_SECONDS=5
# POLICY_MAX_STALENESS_SECONDS=30
# Graceful-drain window: on SIGTERM the kernel stops claiming new work and
# waits up to this many seconds for in-flight handlers (e.g. model calls) to
# finish before cancelling them.
# 优雅关停排水窗口：SIGTERM 后先停新 claim，等在途 handler（如模型调用）自然
# 完成至多这么多秒，超时才 cancel。
# OPENCITADEL_SHUTDOWN_TIMEOUT_SECONDS=90
# The non-root sandbox broker needs group access to the host Docker socket.
# Quickstart detects its group on native Linux with the local standard socket.
# Docker Desktop keeps the Compose default 0. For remote/nonstandard daemons,
# provide an explicit group for the mounted socket; quickstart does not guess.
# DOCKER_SOCK_GID=0
# 8090/8091 = bundled Ops Patrol Collector/Actuator ports (docker-compose.yml
# opencitadel-ops-collector/opencitadel-ops-actuator); also governs registering
# and connecting to any other MCP server on a non-default port.
# OUTBOUND_ALLOWED_PORTS=80,443,8080,8443,8090,8091,11434
# Exact hostnames only. Leave empty unless an operator-approved private
# endpoint (for example an internal Ollama service) is required.
# OUTBOUND_PRIVATE_HOST_ALLOWLIST=
# Only these socket peers may supply X-Forwarded-For; empty trusts none.
# Production accepts only the actual narrow reverse-proxy/ingress CIDRs.
# Broad private-network ranges remain a development compatibility override,
# and are rejected in production.
# TRUSTED_PROXY_CIDRS=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000
# COOKIE_DOMAIN=
# Optional override; otherwise derived from FRONTEND_BASE_URL.
# COOKIE_SECURE=true
# FRONTEND_BASE_URL=http://localhost:8088
# Optional override; otherwise derived from FRONTEND_BASE_URL + /api/auth/oauth.
# OAUTH_REDIRECT_BASE=http://localhost:8088/api/auth/oauth
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD: generated once by quickstart; preserve its stored value.
# BOOTSTRAP_ADMIN_PASSWORD=

# Database (Compose default host: opencitadel-postgres)
# 数据库（Docker Compose 默认主机名 opencitadel-postgres）
# The container admin role is initialization-only. Migration, API, and the
# execution kernel use distinct non-superuser credentials.
# POSTGRES_ADMIN_USER=postgres
# POSTGRES_ADMIN_PASSWORD: generated once by quickstart; preserve its stored value.
# POSTGRES_ADMIN_PASSWORD=
# POSTGRES_MIGRATION_USER=opencitadel_migration_runtime
# POSTGRES_MIGRATION_PASSWORD: generated once by quickstart; preserve its stored value.
# POSTGRES_MIGRATION_PASSWORD=
# POSTGRES_USER=opencitadel_app
# POSTGRES_PASSWORD: generated once by quickstart; preserve its stored value.
# POSTGRES_PASSWORD=
# POSTGRES_KERNEL_USER=opencitadel_execution_kernel_runtime
# POSTGRES_KERNEL_PASSWORD: generated once by quickstart; preserve its stored value.
# POSTGRES_KERNEL_PASSWORD=
# POSTGRES_DB=opencitadel
# POSTGRES_HOST=opencitadel-postgres

# Redis authentication is mandatory in production.
# 生产环境必须启用 Redis 认证。
# REDIS_HOST=opencitadel-redis
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD: generated once by quickstart; preserve its stored value.
# REDIS_PASSWORD=

# Tencent COS (cloud mode; optional in local mode)
# 腾讯云 COS（cloud 模式填写；local 模式可留空）
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_REGION=ap-guangzhou
# COS_BUCKET=
# COS_DOMAIN=

# MinIO (local mode; optional in cloud mode)
# MinIO（local 模式填写；cloud 模式可留空）
# MINIO_ENDPOINT=opencitadel-minio:9000
# MINIO_ACCESS_KEY=opencitadel
# MINIO_SECRET_KEY: generated once by quickstart; preserve its stored value.
# MINIO_SECRET_KEY=
# MINIO_BUCKET=opencitadel
# MINIO_SECURE=false
# Optional public URL for LLM image fetch; empty falls back to base64 inline
# 可选：需要 LLM 直接抓取图片 URL 时填写公网/局域网可达地址；留空则自动回退 base64 内联
# MINIO_PUBLIC_ENDPOINT=

# Nginx host port overrides (Compose only). Quickstart derives the active port
# from FRONTEND_BASE_URL; bare Compose needs an override for a custom URL port.
# Nginx 端口选填覆盖：Quickstart 从站点 URL 派生；裸 Compose 自定义端口需显式设置。
# NGINX_PORT=8088
# NGINX_HTTPS_PORT=443

# Quickstart derives domain and HTTPS enablement from FRONTEND_BASE_URL unless
# explicitly overridden. Prepare real certificates before using an HTTPS URL;
# expected path: /etc/letsencrypt/live/${OPENCITADEL_DOMAIN}/.
# Quickstart 从站点 URL 派生域名和 HTTPS 开关，显式覆盖优先。使用 HTTPS 前需
# 备齐真实证书，路径为 /etc/letsencrypt/live/${OPENCITADEL_DOMAIN}/。
# OPENCITADEL_DOMAIN=
# HTTPS_ENABLED=false
# Host directory mounted read-only at /etc/letsencrypt in nginx. Defaults to
# the empty in-repo placeholder; set to /etc/letsencrypt when enabling HTTPS.
# LETSENCRYPT_DIR=/etc/letsencrypt

# Local models (recommended for local mode)
# 本地模型（local 模式推荐）
# Add endpoints, models, and purpose bindings in Settings → Inference.
# 在设置 → 推理中添加 Endpoint、Model 与用途绑定。
# Provider may be Ollama or an OpenAI-compatible service such as vLLM.
# base_url e.g. http://host.docker.internal:11434/v1 for host Ollama from containers

# Google/GitHub SSO (leave empty to disable)
# Google/GitHub SSO（可选；保持空值则不启用对应登录入口）
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# API /api/metrics requires `Authorization: Bearer <METRICS_TOKEN>`; without
# a token it returns 404. Kernel metrics use the same bearer token when set;
# without one the metrics listener binds to loopback only. A kernel metrics
# port of 0 disables the listener. Keep network restrictions on scrape access.
# API 指标需携带 METRICS_TOKEN，未设置返回 404；内核指标使用同一 Bearer token，
# 未设置时仅监听 loopback。内核指标端口设为 0 可关闭，仍需限制抓取网络范围。
# METRICS_TOKEN: generated once by quickstart; preserve its stored value.
# METRICS_TOKEN=
# EXECUTION_KERNEL_METRICS_PORT=9108

# ---------- Advanced (usually unchanged) / 高级可选项（通常无需修改） ----------

# Optional external DSN override; otherwise derived from POSTGRES_*.
# Use the application's non-superuser credentials, not the initialization role.
# SQLALCHEMY_DATABASE_URI=
# Optional migration DSN override; use the dedicated non-superuser migration role.
# SQLALCHEMY_MIGRATION_DATABASE_URI=
# SQLALCHEMY_ECHO=false
# POSTGRES_POOL_SIZE=5
# POSTGRES_MAX_OVERFLOW=5
# POSTGRES_POOL_RECYCLE_SECONDS=1800
# Execution-kernel batch / backpressure / poll tuning (advanced). The
# ActivityWorker runs at most EXECUTION_ACTIVITY_MAX_CONCURRENCY claims per
# process (a semaphore); keep it <= POSTGRES_POOL_SIZE + POSTGRES_MAX_OVERFLOW
# so concurrent claims never starve the connection pool. batch_size / idle_poll
# govern the drain loop's page size and idle sleep.
# EXECUTION_ACTIVITY_MAX_CONCURRENCY=8
# EXECUTION_ACTIVITY_BATCH_SIZE=100
# EXECUTION_IDLE_POLL_SECONDS=1.0
# Poison-pill caps: an activity task / inbox command claimed more than this
# many times without settling is parked as dead_lettered (no more retries).
# 毒丸上限：activity/inbox 行被 claim 超过该次数仍未结算即转 dead_lettered。
# EXECUTION_ACTIVITY_MAX_CLAIM_ATTEMPTS=5
# EXECUTION_INBOX_MAX_CLAIM_ATTEMPTS=10
# Execution queue retention: the scheduler's leader tick batch-deletes settled
# inbox/outbox rows after 7 days and settled timer/activity rows after 30 days
# (activity rows only once their owning Run is terminal). 0 disables a queue.
# 执行队列保留期：调度器 leader tick 分批清理已完成行；activity 终态行仅在所属
# Run 已终态后清理；0 = 关闭对应队列的自动清理。
# EXECUTION_INBOX_RETENTION_DAYS=7
# 死信 inbox 行（毒丸命令诊断记录）的保留天数，0 表示不清理。
# EXECUTION_INBOX_DEAD_LETTER_RETENTION_DAYS=30
# EXECUTION_OUTBOX_RETENTION_DAYS=7
# EXECUTION_TIMER_RETENTION_DAYS=30
# EXECUTION_ACTIVITY_RETENTION_DAYS=30
# EXECUTION_QUEUE_PURGE_BATCH_SIZE=500
# Admission backpressure: max non-terminal Runs per owner scope (user/team);
# beyond it new Runs are refused with ADMISSION_LIMIT_EXCEEDED. 0 = unlimited.
# 准入背压：单 owner scope 活跃（非终态）Run 上限，超限拒绝新 Run；0 = 不限。
# EXECUTION_MAX_ACTIVE_RUNS_PER_SCOPE=200
# COS_SCHEME=https
# Ops Patrol accepts new Runs by default. Administrators pause admission by
# activating an Operations Policy revision; existing Runs and evidence remain
# readable. Fixture replay is controlled only by the non-production
# PATROL_FIXTURE_REPLAY_ENABLED deployment variable.
# Start the local Collector with: docker compose --profile patrol up opencitadel-ops-collector
# OPS_COLLECTOR_TARGET_REF=opencitadel-local
# OPS_COLLECTOR_ALLOWED_NAMESPACES=["opencitadel"]
# Bearer token the Collector's streamable-http endpoint requires. MUST be a
# strong random value (>= 32 chars); the server refuses to start without it and
# every caller must send `Authorization: Bearer <token>`. Even read-only probes
# are gated to prevent unauthorized reconnaissance.
# OPS_COLLECTOR_TOKEN: generated once by quickstart; preserve its stored value.
# OPS_COLLECTOR_TOKEN=
# Demo probe registration for the collector's http_probes/dependencies
# schema (ops-collector/src/opencitadel_ops_collector/config.py). These
# defaults are baked into docker-compose.yml's `environment:` block for the
# opencitadel-ops-collector service (that service has no env_file, so this
# .env file does NOT feed it directly) — override here only if you need
# different probe targets; compose will substitute your value in place of
# the default JSON.
# OPS_COLLECTOR_HTTP_PROBES={"primary-endpoint":{"url":"http://opencitadel-api:8000/api/status","expected_statuses":[200]},"demo-console":{"url":"http://ops-console:9099/health","expected_statuses":[200]}}
# OPS_COLLECTOR_DEPENDENCIES={"primary-dependencies":{"kind":"postgres","host":"opencitadel-postgres","port":5432},"demo-console-tcp":{"kind":"tcp","host":"ops-console","port":9099}}

# Ops Patrol remediation is fail-closed by default. Activate an Operations
# Policy revision with `patrol.remediation` set as appropriate.
# Start the local Actuator with:
# docker compose --profile actuator up opencitadel-ops-actuator
# OPS_ACTUATOR_TARGET_REF=opencitadel-local
# OPS_ACTUATOR_ALLOWED_NAMESPACES=["opencitadel"]
# Bearer token the Actuator's streamable-http endpoint requires. MUST be a
# strong random value (>= 32 chars); the server refuses to start without it and
# every caller must send `Authorization: Bearer <token>`. This is the only
# application-layer boundary in front of the destructive write actions
# (restart/scale/rollback), so treat it as a production secret. Consumed by
# the ops-actuator server process only; the API learns it via the Authorization
# header you set when registering the Actuator MCP server (Settings ->
# Integrations), not from this variable.
# OPS_ACTUATOR_TOKEN: generated once by quickstart; preserve its stored value.
# OPS_ACTUATOR_TOKEN=

# Demo profile (OpsConsole ticket backend for Web Operator e2e)
# docker compose --profile local --profile demo up
# OPS_CONSOLE_PORT=9099

# Optional demo-seed inference inputs. Add these to the selected .env before
# running quickstart --demo. Empty inputs skip inference provisioning; endpoint,
# model and binding can instead be configured in Settings → Inference.
# Demo 推理选填：启动 quickstart --demo 前添加；留空则在登录后通过设置配置。
# DEMO_INFERENCE_BASE_URL=https://api.openai.com/v1
# DEMO_INFERENCE_CREDENTIAL=sk-...
# DEMO_INFERENCE_MODEL=gpt-4o-mini
# DEMO_INFERENCE_PROVIDER=openai

# Docker 构建期镜像源（覆盖 docker-compose build args 默认值）
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# PIP_TRUSTED_HOST=mirrors.aliyun.com
# UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# UV_VERSION=0.11.33
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# ==================== Optional features / 可选功能（留空 = 关闭） ====================

# Outbound email notifications (scheduled-job notify channels). Empty host
# disables email delivery silently -- configure all of these to enable it.
# 外发邮件通知（定时任务 notify channels）。SMTP_HOST 留空 = 邮件通道静默关闭。
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true

# Cross-origin API access is disabled by default (same-origin via nginx).
# Set an explicit comma-separated origin list when cross-origin access is needed.
# 默认仅经 nginx 同源访问；需要跨域时显式填逗号分隔的来源列表。
# CORS_ORIGINS=

# OpenTelemetry traces. Disabled by default; set all three to export spans.
# OpenTelemetry 链路追踪。默认关闭；三项都设置后才会导出 span。
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=opencitadel-api
# OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317

# Structured logs: text (default) | json
# LOG_FORMAT=text

# Web search tool provider: searxng | tavily | bing_api | bing_html (default,
# scrapes Bing HTML -- fragile, may be bot-challenged) | none (tool disabled).
# searxng needs SEARCH_ENDPOINT (e.g. http://searxng:8080); tavily / bing_api
# need SEARCH_API_KEY. API providers fail loudly instead of returning empty.
# Web 搜索提供方；searxng 需 SEARCH_ENDPOINT，tavily/bing_api 需 SEARCH_API_KEY，
# none 表示不注册搜索工具。
# SEARCH_PROVIDER=bing_html
# SEARCH_ENDPOINT=
# SEARCH_API_KEY=

# Recycle-bin retention: soft-deleted sessions / knowledge bases are physically
# purged (audited) by the scheduler once deleted_at exceeds this many days.
# 0 disables automatic purging (manual purge only).
# 回收站保留期：软删数据超期后由调度器自动物理清除并写审计；0 = 关闭自动清理。
# RECYCLE_BIN_RETENTION_DAYS=30
# RECYCLE_BIN_PURGE_BATCH_SIZE=100

# Evaluation deployment ceilings (admin configured; restart API/workers together).
# Suite limits cannot exceed these values. These do not allocate E05 concurrency pools.
# EVALUATION_POLL_INTERVAL_SECONDS=1.0
# EVALUATION_CASE_TIMEOUT_SECONDS=1800
# EVALUATION_BATCH_TIMEOUT_SECONDS=86400
# EVALUATION_SUBJECT_CONCURRENCY=5
# EVALUATION_JUDGE_CONCURRENCY=2
# EVALUATION_ENVIRONMENT_CONCURRENCY=2

# Advanced execution and physical budget ceilings; empty limits are uncapped.
# EVALUATION_EXECUTION_POLICY_REVISION=1
# EVALUATION_EXECUTION_GLOBAL_LIMIT=
# EVALUATION_EXECUTION_USER_LIMIT=
# PHYSICAL_BUDGET_POLICY_REVISION=1
# PHYSICAL_GLOBAL_CONCURRENCY=
# PHYSICAL_USER_CONCURRENCY=
# PHYSICAL_PROVIDER_CONCURRENCY=

# Independent isolated-environment capacity (workspace default 2; global/user uncapped).
# EVALUATION_ENVIRONMENT_POLICY_REVISION=1
# EVALUATION_ENVIRONMENT_GLOBAL_LIMIT=
# EVALUATION_ENVIRONMENT_USER_LIMIT=

# Evaluation broker operation journal; choose a persistent deployment path.
# EVALUATION_BROKER_JOURNAL_PATH=/var/lib/opencitadel-evaluation/operations.sqlite

# Isolated acceptance/local fixtures only; disabled by default, never required
# for normal startup. Production needs a separately registered evaluation adapter.
# 验收/本地夹具专用，默认关闭；正常启动无需填写，生产需注册独立评估适配器。
# EVALUATION_ACCEPTANCE_ENABLED=false
# EVALUATION_LOCAL_DOCKER_ENABLED=false
# EVALUATION_TEST_INVENTORY_PATH=
# EVALUATION_BUDGET_INVENTORY_PATH=
# PATROL_FIXTURE_REPLAY_ENABLED=false

# Maximum seconds Compose waits for service readiness during quickstart.
# QUICKSTART_WAIT_TIMEOUT_SECONDS=300
