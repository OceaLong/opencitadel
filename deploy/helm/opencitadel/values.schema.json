{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "opsCollector": {
      "type": "object",
      "required": ["enabled", "targetRef", "allowedNamespaces"],
      "properties": {
        "enabled": { "type": "boolean" },
        "targetRef": { "type": "string", "minLength": 1 },
        "allowedNamespaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "serviceAccount": {
          "type": "object",
          "required": ["create", "name"],
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": [
        "apiKeySecret",
        "auditSigningKey",
        "jwtSecret",
        "sessionSecret",
        "bootstrapAdminPassword",
        "postgresAdminPassword",
        "postgresPassword",
        "redisPassword"
      ],
      "properties": {
        "apiKeySecret": { "type": "string", "minLength": 32 },
        "auditSigningKey": { "type": "string", "minLength": 32 },
        "jwtSecret": { "type": "string", "minLength": 32 },
        "sessionSecret": { "type": "string", "minLength": 32 },
        "bootstrapAdminPassword": { "type": "string", "minLength": 12 },
        "postgresAdminPassword": { "type": "string", "minLength": 16 },
        "postgresPassword": { "type": "string", "minLength": 16 },
        "redisPassword": { "type": "string", "minLength": 16 }
      }
    }
  }
}
