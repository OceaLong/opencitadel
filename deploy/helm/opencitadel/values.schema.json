{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "noPlaceholder": {
      "not": {
        "pattern": "(?i)(replace-with|change-?me|change-in-production)"
      }
    }
  },
  "properties": {
    "replicaCount": {
      "type": "object",
      "not": {
        "required": [
          "worker"
        ]
      }
    },
    "image": {
      "type": "object",
      "not": {
        "required": [
          "worker"
        ]
      }
    },
    "executionKernel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "databaseUser",
        "metricsPort"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "databaseUser": {
          "type": "string",
          "minLength": 1
        },
        "metricsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeoutSeconds",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "opsCollector": {
      "type": "object",
      "required": [
        "enabled",
        "targetRef",
        "allowedNamespaces"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "targetRef": {
          "type": "string",
          "minLength": 1
        },
        "allowedNamespaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "token": {
          "type": "string",
          "$ref": "#/$defs/noPlaceholder",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 32
            }
          ]
        },
        "serviceAccount": {
          "type": "object",
          "required": [
            "create",
            "name"
          ],
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            }
          }
        }
      }
    },
    "opsActuator": {
      "type": "object",
      "required": [
        "enabled",
        "targetRef",
        "allowedNamespaces"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "targetRef": {
          "type": "string",
          "minLength": 1
        },
        "allowedNamespaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "token": {
          "type": "string",
          "$ref": "#/$defs/noPlaceholder",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 32
            }
          ]
        },
        "serviceAccount": {
          "type": "object",
          "required": [
            "create",
            "name"
          ],
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "not": {
        "required": [
          "worker"
        ]
      }
    },
    "env": {
      "type": "object",
      "properties": {
        "TRUSTED_PROXY_CIDRS": {
          "type": "string",
          "not": {
            "pattern": "(^|,)\\s*(10\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|192\\.168\\.)[0-9.]*/([0-9]|1[0-9]|2[0-3])\\s*(,|$)"
          }
        }
      }
    },
    "securityHeaders": {
      "type": "object",
      "required": [
        "contentSecurityPolicy"
      ],
      "properties": {
        "contentSecurityPolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "minLength": 1
            },
            "scrapeTimeout": {
              "type": "string",
              "minLength": 1
            },
            "labels": {
              "type": "object"
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "apiKeySecret": {
          "type": "string",
          "$ref": "#/$defs/noPlaceholder",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 32
            }
          ]
        },
        "auditSigningKey": {
          "type": "string",
          "$ref": "#/$defs/noPlaceholder",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 32
            }
          ]
        },
        "jwtSecret": {
          "type": "string",
          "$ref": "#/$defs/noPlaceholder",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 32
            }
          ]
        },
        "sessionSecret": {
          "type": "string",
          "$ref": "#/$defs/noPlaceholder",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 32
            }
          ]
        },
        "sandboxTokenSeed": {
          "type": "string",
          "$ref": "#/$defs/noPlaceholder",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 32
            }
          ]
        },
        "bootstrapAdminPassword": {
          "type": "string",
          "$ref": "#/$defs/noPlaceholder",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 12
            }
          ]
        },
        "postgresAdminPassword": {
          "type": "string",
          "$ref": "#/$defs/noPlaceholder",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 16
            }
          ]
        },
        "postgresMigrationPassword": {
          "type": "string",
          "$ref": "#/$defs/noPlaceholder",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 16
            }
          ]
        },
        "postgresPassword": {
          "type": "string",
          "$ref": "#/$defs/noPlaceholder",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 16
            }
          ]
        },
        "executionKernelPostgresPassword": {
          "type": "string",
          "$ref": "#/$defs/noPlaceholder",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 16
            }
          ]
        },
        "redisPassword": {
          "type": "string",
          "$ref": "#/$defs/noPlaceholder",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 16
            }
          ]
        },
        "metricsToken": {
          "type": "string",
          "$ref": "#/$defs/noPlaceholder",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 32
            }
          ]
        },
        "databaseAuthorizationSigningSecret": {
          "type": "string",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 32
            }
          ],
          "$ref": "#/$defs/noPlaceholder"
        },
        "publicCursorSecret": {
          "type": "string",
          "anyOf": [
            {
              "const": ""
            },
            {
              "minLength": 32
            }
          ],
          "$ref": "#/$defs/noPlaceholder"
        }
      }
    },
    "publicUrl": {
      "type": "string",
      "anyOf": [
        {
          "const": ""
        },
        {
          "pattern": "^https?://[^/]+/?$"
        }
      ]
    },
    "existingSecrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "application": {
          "type": "string"
        },
        "postgresBootstrap": {
          "type": "string"
        },
        "migration": {
          "type": "string"
        },
        "executionKernel": {
          "type": "string"
        },
        "opsCollector": {
          "type": "string"
        },
        "opsActuator": {
          "type": "string"
        }
      }
    }
  }
}
